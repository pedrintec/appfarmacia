{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CSV smoke test",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/tests/csvExport.test.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Start Expo (Metro)",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
